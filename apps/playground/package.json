    "typecheck": "npm run docs && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@weasel-js/core": "1.9.0",
    "@weasel-js/diagram": "1.9.0",
    "@weasel-js/labkit": "1.9.0",
    "@weasel-js/theme": "1.9.0",
    "@weasel-js/ui": "1.9.0",
    "acorn": "8.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@weasel-js/forge": "1.9.0",
    "playwright": "1.63.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0",
    "vite": "^8.0.0"
  }
