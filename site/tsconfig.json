{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@brand/*": ["../brand/*"],
      "@pg/*": ["../apps/playground/src/*"],
      "bree": ["./vendor/bree/index.ts"],
      "@msb235/blits": ["../src/index.ts"],
      "@msb235/blits/lean": ["../src/lean.ts"],
      "@msb235/blits/gpu": ["../src/gpu.ts"],
      "@msb235/blits/testing": ["../src/testing.ts"],
      "@msb235/blits-panel": ["../packages/panel/src/index.ts"],
      "@msb235/blits-rapier": ["../packages/rapier/src/index.ts"]
    },
    "resolveJsonModule": true
  },
  "include": [".astro/types.d.ts", "src", "../src"]
}
