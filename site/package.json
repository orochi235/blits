{
  "name": "@blits/site",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "typedoc --json .generated/api.json --tsconfig ../tsconfig.json ../src/index.ts --excludePrivate --excludeInternal --sort source-order --logLevel Warn",
    "dev": "npm run api && astro dev --host :: --port 4872",
    "build": "npm run api && astro build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/react": "^7.0.0",
    "@weasel-js/core": "^1.7.1",
    "@weasel-js/labkit": "^1.7.1",
    "@weasel-js/theme": "^1.7.1",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.0"
  }
}
