---
import '../styles/site.css';
import { extra, words } from '../nav';

interface Props {
  frontmatter?: { title?: string; description?: string };
  title?: string;
}
const fm = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? fm.title ?? 'blits';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = Astro.url.pathname;
const link = (slug: string) => `${base}${slug ? `${slug}/` : ''}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'blits' ? 'blits' : `blits: ${title}`}</title>
    {fm.description && <meta name="description" content={fm.description} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@87.5,500;87.5,700&family=JetBrains+Mono:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    <div class="frame">
      <nav class="rail" aria-label="Pages">
        <a class="mark" href={link('')}>blits</a>
        <ol class="words">
          {words.map((w) => (
            <li><a href={link(w.slug)} aria-current={here === link(w.slug) ? 'page' : undefined}>{w.title}</a></li>
          ))}
        </ol>
        <ul class="extra">
          {extra.map((w) => (
            <li><a href={link(w.slug)} aria-current={here === link(w.slug) ? 'page' : undefined}>{w.title}</a></li>
          ))}
        </ul>
      </nav>
      <main id="main" class="page">
        <slot />
      </main>
    </div>
  </body>
</html>
