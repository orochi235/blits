---
/** blits' debug panel, on when the URL says `?panel` (remembered) and off for `?panel=off`. */
---
<script>
  const KEY = 'blits-site:panel';
  const param = new URLSearchParams(location.search).get('panel');
  let on = false;
  if (param === null) {
    try {
      on = localStorage.getItem(KEY) === 'on';
    } catch {}
  } else {
    on = param !== 'off';
    try {
      if (on) localStorage.setItem(KEY, 'on');
      else localStorage.removeItem(KEY);
    } catch {}
  }
  // The dev server compiles the panel for React's fast refresh, which needs the preamble that
  // @astrojs/react writes only into pages with a React island.
  const preamble = async () => {
    const w = window as unknown as Record<string, unknown>;
    if (!import.meta.env.DEV || w.__vite_plugin_react_preamble_installed__) return;
    const url = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}@react-refresh`;
    const { default: refresh } = await import(/* @vite-ignore */ url);
    refresh.injectIntoGlobalHook(window);
    w.$RefreshReg$ = () => {};
    w.$RefreshSig$ = () => (type: unknown) => type;
    w.__vite_plugin_react_preamble_installed__ = true;
  };
  if (on)
    void preamble()
      .then(() => import('@msb235/blits-panel'))
      .then(({ mount }) => mount());
</script>
