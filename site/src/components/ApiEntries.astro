---
import { type Entry, entriesFor } from '../api';
import ApiEntry from './ApiEntry.astro';

interface Props {
  word?: string;
  list?: Entry[];
  heading?: string;
  /** The page these entries sit on: `reference`, or the word whose page it is. */
  here?: string;
}
const list = Astro.props.list ?? entriesFor(Astro.props.word ?? '');
const heading = Astro.props.heading ?? 'Reference';
const here = Astro.props.here ?? Astro.props.word ?? 'reference';
---
{list.length > 0 && (
  <section class="api" data-word={list[0]?.word}>
    <h2>{heading}</h2>
    {list.map((e) => <ApiEntry entry={e} here={here} />)}
  </section>
)}
