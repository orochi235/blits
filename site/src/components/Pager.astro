---
import { reading } from '../nav';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = Astro.url.pathname;
const pages = [{ slug: '', title: 'Home' }, ...reading];
const href = (slug: string) => (slug === '' ? base : `${base}${slug}/`);
const at = pages.findIndex((p) => href(p.slug) === here);
const prev = at > 0 ? pages[at - 1] : undefined;
const next = at >= 0 ? pages[at + 1] : undefined;
---
{(prev || next) && (
  <nav class="pager" aria-label="Previous and next" data-pagefind-ignore>
    {prev && <a class="prev" href={href(prev.slug)}><span>Previous</span>{prev.title}</a>}
    {next && <a class="next" href={href(next.slug)}><span>Next</span>{next.title}</a>}
  </nav>
)}

<style>
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 40rem;
    margin-top: 4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font: 700 1rem / 1.3 var(--label);
    font-stretch: 87.5%;
  }

  a {
    text-decoration: none;
  }

  .next {
    margin-left: auto;
    text-align: end;
  }

  span {
    display: block;
    font-weight: 500;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
</style>
