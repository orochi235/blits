---
/** A printed signature or type, colored by role, with each exported type name linked to its entry. */
import { hrefFor, type Tok } from '../api';

interface Props {
  toks: Tok[];
  here: string;
}
const { toks, here } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
{toks.map((t) => {
  if (t.kind === 'punct') return t.text;
  const href = t.kind === 'ref' ? hrefFor(t.text, here, base) : undefined;
  return href ? <a class="tk-ref" href={href}>{t.text}</a> : <span class={`tk-${t.kind}`}>{t.text}</span>;
})}
