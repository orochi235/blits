---
import Page from '../../layouts/Page.astro';
import { guides } from '../../nav';

const pages = import.meta.glob<{ frontmatter: { description?: string } }>('./*.mdx', { eager: true });
const described = guides.map((g) => {
  const page = pages[`./${g.slug}.mdx`];
  if (page === undefined) throw new Error(`guides: nav lists ${g.slug}, which has no page`);
  return { ...g, description: page.frontmatter.description };
});
---
<Page title="Guides" description="One task each: the frame loop, effects in order, scrubbing, React, three.js, patch libraries, bundle size, and debugging.">
  <h1>Guides</h1>
  <p class="lede">One task each, for after <a href="../start/">Get started</a>. The pages under Words explain the ideas; these put them to work.</p>
  <dl class="guides">
    {described.map((g) => (
      <>
        <dt><a href={`./${g.slug}/`}>{g.title}</a></dt>
        <dd>{g.description}</dd>
      </>
    ))}
  </dl>
</Page>

<style>
  .guides dt {
    font: 700 1.1rem / 1.3 var(--label);
    font-stretch: 87.5%;
    margin-top: 1.25rem;
  }

  .guides dd {
    margin: 0.2rem 0 0;
    color: var(--ink-soft);
  }
</style>
