{
  "name": "@msb235/blits-panel",
  "version": "0.4.1",
  "description": "A debugger window for blits: every mix on the page, its voices and subjects, channels plotted over time, and a clock to pause, step and scrub",
  "keywords": [
    "blits",
    "debugger",
    "devtools",
    "animation"
  ],
  "license": "MIT",
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/blits.git",
    "directory": "packages/panel"
  },
  "homepage": "https://github.com/orochi235/blits/tree/main/packages/panel#readme",
  "bugs": "https://github.com/orochi235/blits/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -b",
    "prepack": "rm -rf dist && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@weasel-js/history": "1.12.0",
    "@weasel-js/theme": "1.12.0",
    "@weasel-js/ui": "1.12.0"
  },
  "peerDependencies": {
    "@msb235/blits": "^0.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@msb235/blits": "0.16.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "happy-dom": "21.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.0.0"
  }
}
