{
  "name": "blits",
  "version": "0.1.0",
  "description": "Concurrent effects: each on its own clock with its own state and weight, folded into one value per subject per frame",
  "keywords": [
    "animation",
    "effects",
    "mixer",
    "keyframes",
    "blending"
  ],
  "license": "MIT",
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/blits.git"
  },
  "homepage": "https://github.com/orochi235/blits#readme",
  "bugs": "https://github.com/orochi235/blits/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/schema.html",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
