{
  "name": "@msb235/blits",
  "version": "0.7.1",
  "description": "Concurrent effects: each on its own clock with its own state and weight, folded into one value per subject per frame",
  "keywords": [
    "animation",
    "effects",
    "mixer",
    "keyframes",
    "blending"
  ],
  "license": "MIT",
  "author": "orochi235",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orochi235/blits.git"
  },
  "homepage": "https://github.com/orochi235/blits#readme",
  "bugs": "https://github.com/orochi235/blits/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "docs/schema.html",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && tsc -b packages/quarks && tsc -p packages/quarks/tsconfig.test.json",
    "lint": "biome check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "bench": "npm run build && node bench/frame.mjs",
    "site": "npm run dev -w site",
    "site:build": "npm run build -w site",
    "site:smoke": "npm run smoke -w site",
    "playground": "npm run dev -w @blits/playground",
    "playground:smoke": "npm run smoke -w @blits/playground",
    "playground:check": "npm run typecheck -w @blits/playground && vitest run apps/playground/test && npm run playground:smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@weasel-js/history": "1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "site",
    "packages/*",
    "apps/*"
  ]
}
