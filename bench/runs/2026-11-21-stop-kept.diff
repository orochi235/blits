diff --git a/src/kept.ts b/src/kept.ts
new file mode 100644
index 00000000..2cf77061
--- /dev/null
+++ b/src/kept.ts
@@ -0,0 +1,62 @@
+import { Store } from './store.js';
+import type { Subject } from './subject.js';
+
+/** What a mix keeps per subject in one entry: its chain head and the voices naming it. */
+export class Kept {
+  head: Subject<unknown> | undefined = undefined;
+  list: unknown[] | undefined = undefined;
+}
+
+/** A subject's chain head, kept in the entry it shares with `named`'s list. */
+export class Heads<I> extends Store<I, Subject<unknown>> {
+  constructor(private readonly kept: Store<I, Kept>) {
+    super();
+  }
+
+  override get(key: I): Subject<unknown> | undefined {
+    return this.kept.get(key)?.head;
+  }
+
+  override set(key: I, value: Subject<unknown>): void {
+    let k = this.kept.get(key);
+    if (k === undefined) {
+      k = new Kept();
+      this.kept.set(key, k);
+    }
+    k.head = value;
+  }
+
+  override delete(key: I): void {
+    const k = this.kept.get(key);
+    if (k === undefined) return;
+    k.head = undefined;
+    if (k.list === undefined) this.kept.delete(key);
+  }
+}
+
+/** The voices naming a subject, kept in the entry it shares with its chain head. */
+export class Lists<I, V> extends Store<I, V[]> {
+  constructor(private readonly kept: Store<I, Kept>) {
+    super();
+  }
+
+  override get(key: I): V[] | undefined {
+    return this.kept.get(key)?.list as V[] | undefined;
+  }
+
+  override set(key: I, value: V[]): void {
+    let k = this.kept.get(key);
+    if (k === undefined) {
+      k = new Kept();
+      this.kept.set(key, k);
+    }
+    k.list = value;
+  }
+
+  override delete(key: I): void {
+    const k = this.kept.get(key);
+    if (k === undefined) return;
+    k.list = undefined;
+    if (k.head === undefined) this.kept.delete(key);
+  }
+}
