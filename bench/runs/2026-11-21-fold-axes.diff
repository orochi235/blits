+  into: Float64Array,
+  at: number,
+  from: Float64Array,
+  fromAt: number,
+  n: number,
+  w: number,
+): void {
+  if (op === 'sum')
+    for (let a = 0; a < n; a++)
+      into[at + a] = add(into[at + a] as number, times(from[fromAt + a] as number, w));
+  else
+    for (let a = 0; a < n; a++)
+      into[at + a] = foldNumber(op, into[at + a] as number, from[fromAt + a] as number, w);
+}
